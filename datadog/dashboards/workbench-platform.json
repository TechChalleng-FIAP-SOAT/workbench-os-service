{
  "title": "Workbench | Visão Geral da Plataforma",
  "description": "Visão unificada dos 4 microsserviços (os/billing/execution/customer). Agrega throughput, latência p95, erros e recursos por serviço, além das métricas de negócio da Ordem de Serviço e do fluxo Saga. Variável env: developer/homolog/production.",
  "layout_type": "ordered",
  "template_variables": [{"name":"env","prefix":"env","default":"production","available_values":["developer","homolog","production"]}],
  "widgets": [
    {"definition":{
      "type":"group","title":"Saúde dos microsserviços","layout_type":"ordered","widgets":[
        {"definition":{"type":"timeseries","title":"Throughput por serviço (req/s)","requests":[{"q":"sum:trace.servlet.request.hits{env:$env} by {service}.as_rate()","display_type":"line"}]}},
        {"definition":{"type":"timeseries","title":"Latência p95 por serviço","requests":[{"q":"p95:trace.servlet.request{env:$env} by {service}","display_type":"line"}]}},
        {"definition":{"type":"timeseries","title":"Erros HTTP por serviço","requests":[{"q":"sum:trace.servlet.request.errors{env:$env} by {service}.as_rate()","display_type":"bars"}]}},
        {"definition":{"type":"timeseries","title":"CPU dos pods por serviço","requests":[{"q":"avg:kubernetes.cpu.usage.total{env:$env} by {service}","display_type":"line"}]}},
        {"definition":{"type":"timeseries","title":"Memória dos pods por serviço","requests":[{"q":"avg:kubernetes.memory.usage{env:$env} by {service}","display_type":"line"}]}}
      ]
    }},
    {"definition":{
      "type":"group","title":"Negócio da Ordem de Serviço (os-service)","layout_type":"ordered","widgets":[
        {"definition":{"type":"timeseries","title":"Ordens de serviço criadas","requests":[{"q":"sum:workshop.service_orders.created{service:os-service,env:$env}.as_count()","display_type":"bars"}]}},
        {"definition":{"type":"timeseries","title":"Tempo médio por etapa","requests":[{"q":"avg:workshop.service_orders.status.duration.avg{service:os-service,env:$env} by {status}","display_type":"line"}]}},
        {"definition":{"type":"timeseries","title":"Falhas no processamento de OS","requests":[{"q":"sum:workshop.service_orders.processing.failed{service:os-service,env:$env} by {operation}.as_count()","display_type":"bars"}]}},
        {"definition":{"type":"timeseries","title":"Falhas de integração","requests":[{"q":"sum:workshop.integrations.failed{service:os-service,env:$env} by {integration}.as_count()","display_type":"bars"}]}}
      ]
    }}
  ]
}
